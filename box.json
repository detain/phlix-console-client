{
    "chmod": "0755",
    "alias": "phlix.phar",
    "compactors": [],
    "git-commit": "git_commit",
    "main": "bin/phlix",
    "finder": [
        {
            "name": "*.php",
            "exclude": ["Tests", "tests", "test", "humbug"],
            "in": ["vendor"]
        },
        {
            "name": ["*.php", "*.stub"],
            "exclude": ["Tests", "tests", "test", ".phpstorm.meta.php", "phpstan.stubs.php"],
            "in": ["src"]
        },
        {
            "name": "*.php",
            "in": ["resources"]
        }
    ],
    "metadata": {
        "name": "phlix/console-client",
        "description": "Terminal TUI client for Phlix"
    },
    "output": "build/phlix.phar",
    "stub": true
}
