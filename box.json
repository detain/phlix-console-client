{
    "chmod": "0755",
    "compactors": [
        "KevinGH\\Box\\Compactor\\PhpScoper",
        "KevinGH\\Box\\Compactor\\Composer"
    ],
    "main": "bin/phlix",
    "finder": [
        {
            "name": "*.php",
            "exclude": ["Tests", "tests", "test"],
            "in": ["vendor"]
        },
        {
            "name": ["*.php", "*.stub"],
            "exclude": ["Tests", "tests", "test", ".phpstorm.meta.php", "phpstan.stubs.php"],
            "in": ["src"]
        }
    ],
    "gitignore": [
        "/*.phar",
        "/build/*.phar",
        "/.phpunit.cache"
    ],
    "metadata": {
        "name": "phlix/console-client",
        "version": "1.0.0",
        "description": "Terminal TUI client for Phlix"
    },
    "output": "build/phlix.phar",
    "stub": true,
    "web": false
}
