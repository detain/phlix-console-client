#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * phlix-console-client CLI entrypoint.
 *
 * Handles: doctor, poster, frame, watch, run, version, and help commands.
 * Exits 2 on unknown commands or usage errors; 1 on caught exceptions.
 */

const PHLIX_VERSION = '1.0.0';

const HELP_TEXT = <<<TXT
phlix — Phlix console client

usage:
  phlix doctor                              report terminal + server diagnostics
  phlix poster <image> [w] [h]              render an image at a cell size
  phlix frame  <video|gif> [n] [cols] [rows]  decode N frames to ANSI
  phlix watch [--hub URL] [--server-id ID] [--once] [--timeout SECS]
                    consume hub-relay "play X" commands
                    (tokens: env PHLIX_*_TOKEN or --hub-token-stdin / --relay-token-stdin)
  phlix run [--mode=…] [--selftest]         launch the full-window app (needs a TTY);
                                            --selftest runs the wiring ladder headless
  phlix version  (-V / --version)           print version information
  phlix help     (-h / --help)              show this help message

render modes:
  halfblock | quarterblock | ascii | ansi256 | truecolor (cell modes)
  sixel | kitty | iterm2 (graphics modes)   auto = halfblock default

In-app keys: ↑↓←→ navigate · / search · Ctrl-K / : command palette
 · Enter open · p play · A–Z jump · Esc back · Ctrl-C quit

watch options:
  --hub URL            hub base URL (env PHLIX_HUB_URL)
  --server-id ID       hub-side server id (env PHLIX_HUB_SERVER_ID)
  --hub-token-stdin    read the hub user access token from STDIN (no argv
                       exposure; pipes / process substitution work)
  --relay-token-stdin  read a ready-made relay token from STDIN (ditto)
  --hub-token JWT      DEPRECATED (prefer env PHLIX_HUB_TOKEN or
                       --hub-token-stdin): argv is world-readable for the
                       process lifetime (ps(1), /proc, shell history).
                       Still accepted, warns on every use.
  --relay-token T      DEPRECATED (prefer env PHLIX_RELAY_TOKEN or
                       --relay-token-stdin): ditto
  --once               connect, wait for ONE play_media command, then exit
  --timeout SECS       with --once: give up after SECS (default 30)

TXT;

use Phlix\Console\Api\ApiClient;
use Phlix\Console\Api\SyncPlay\HubRelayConsumer;
use Phlix\Console\Api\SyncPlay\PendingPlayMediaCommand;
use Phlix\Console\App;
use Phlix\Console\Capabilities;
use Phlix\Console\Config\Config;
use Phlix\Console\Config\TokenStore;
use Phlix\Console\Media\MosaicFactory;
use Phlix\Console\Media\PosterLoader;
use Phlix\Console\Spike\PosterSpike;
use Phlix\Console\Spike\VideoSpike;
use Phlix\Console\Screen\PlayerScreen;
use Phlix\Console\Store\AuthStore;
use Phlix\Console\Store\LibrariesStore;
use Phlix\Console\Store\MediaStore;
use SugarCraft\Core\Program;
use SugarCraft\Core\ProgramOptions;
use SugarCraft\Image\DiskCache;
use Workerman\Events\Select;
use Workerman\Timer;
use Workerman\Worker;

// Locate the Composer autoloader whether we run from the repo or as an
// installed dependency in someone else's vendor/.
foreach ([__DIR__ . '/../vendor/autoload.php', __DIR__ . '/../../../autoload.php'] as $autoload) {
    if (is_file($autoload)) {
        require $autoload;
        break;
    }
}
if (!class_exists(Program::class)) {
    fwrite(STDERR, "Phlix: Composer autoloader not found — run `composer install`.\n");
    exit(1);
}

/**
 * Builds the full production object graph — shared by `run` and `run --selftest`.
 *
 * @return array{config: Config, auth: AuthStore, api: ApiClient, libraries: LibrariesStore, media: MediaStore, posters: PosterLoader}
 */
function buildContainer(?string $mode): array
{
    $config = Config::load();
    // Honour PHLIX_SERVER_URL from the environment for CI / stub server use.
    $serverUrl = getenv('PHLIX_SERVER_URL') ?: $config->activeServer()?->url;
    $api = new ApiClient($serverUrl ?? '');
    $auth = new AuthStore($api, TokenStore::default());
    $libraries = new LibrariesStore($api);
    $media = new MediaStore($api);
    // Cell modes tile as text; graphics modes (sixel/kitty/iterm2) tile as
    // an overlay — PosterLoader routes them by Mosaic::isInline() and keys
    // its cache by protocol(), so each mode caches separately.
    $posterCacheEntries = (int) getenv('PHLIX_POSTER_CACHE_ENTRIES');
    if ($posterCacheEntries < 1) {
        $posterCacheEntries = 16384;
    }
    $posters = new PosterLoader(MosaicFactory::forPosterGrid($mode), new DiskCache(Config::dir() . '/posters', $posterCacheEntries));

    return [
        'config' => $config,
        'auth' => $auth,
        'api' => $api,
        'libraries' => $libraries,
        'media' => $media,
        'posters' => $posters,
    ];
}

/**
 * Runs the selftest: builds the full container and verifies the graph is wired.
 *
 * @return bool true if all checks passed, false otherwise
 */
function runSelftest(?string $mode): bool
{
    $checks = [];
    $allPassed = true;

    // 1. config-loaded
    $config = Config::load();
    $serverUrl = getenv('PHLIX_SERVER_URL') ?: $config->activeServer()?->url;
    if ($config !== null && $serverUrl !== null && $serverUrl !== '') {
        $checks[] = 'OK config-loaded';
    } else {
        $checks[] = 'FAIL config-loaded serverUrl is empty';
        $allPassed = false;
    }

    // 2. graph-wired — every service in the graph is non-null
    if ($allPassed) {
        $container = buildContainer($mode);
        $nulls = [];
        foreach ($container as $name => $value) {
            if ($value === null) {
                $nulls[] = $name;
            }
        }

        // Also verify App::boot() itself returns non-null
        try {
            $app = App::boot(
                $container['config'],
                $container['auth'],
                $container['api'],
                $container['libraries'],
                $container['media'],
                $container['posters'],
            );
            if ($app === null) {
                $nulls[] = 'app (App::boot returned null)';
            }
        } catch (\Throwable $e) {
            $checks[] = 'FAIL graph-wired App::boot threw: ' . $e->getMessage();
            $allPassed = false;
            $app = null;
        }

        if ($nulls !== []) {
            $checks[] = 'FAIL graph-wired null services: ' . implode(', ', $nulls);
            $allPassed = false;
        } else {
            $checks[] = 'OK graph-wired';
        }

        // Explicitly verify PlayerScreen's SyncPlayService dependency is wired.
        // The SyncPlayService is a constructor parameter of PlayerScreen and should
        // be injected via the DI container / App when openPlayer() creates the screen.
        // We verify by checking the openPlayer method's implementation path.
        if ($allPassed && $app !== null) {
            try {
                // PlayerScreen::openPlayer() calls: new PlayerScreen(..., ?SyncPlayService $syncPlayService = null)
                // The hole (C1.2) is that SyncPlayService is passed as null.
                // We verify the SYMPTOM: if we try to build a PlayerScreen with null
                // SyncPlayService, the SyncPlayService field should be non-null after construction.
                // Since we can't easily instantiate PlayerScreen without real dependencies,
                // we verify the production factory builds correctly (prerequisite).
                $factory = PlayerScreen::productionFactory(
                    $container['posters']->protocol(),
                    $container['posters']->cellSize(),
                );
                if ($factory === null) {
                    $checks[] = 'FAIL graph-wired PlayerScreen::productionFactory returned null';
                    $allPassed = false;
                }
                // Verify SyncPlayService is not nullable in the actual constructor
                // (if it is still nullable, the hole exists).
                $refl = new \ReflectionParameter(
                    [PlayerScreen::class, '__construct'],
                    'syncPlayService',
                );
                if ($refl->isOptional()) {
                    // SyncPlayService is still optional/nullable — the C1.2 hole exists
                    $checks[] = 'FAIL graph-wired PlayerScreen SyncPlayService is still nullable (C1.2 hole not fixed)';
                    $allPassed = false;
                }
                // If we get here with a non-null factory, the graph is wired.
            } catch (\Throwable $e) {
                $checks[] = 'FAIL graph-wired PlayerScreen check: ' . $e->getMessage();
                $allPassed = false;
            }
        }
    }

    // 3. http-reachable — make one real HTTP request to GET /api/v1/libraries
    // 4. decode-ok — the response body decodes without throwing
    if ($allPassed && $serverUrl !== null && $serverUrl !== '') {
        if (!function_exists('curl_init')) {
            // ext-curl is not a declared dependency: without it this ladder
            // rung reports an honest FAIL instead of fataling on undefined
            // functions (mirrors the mintRelayToken guard; review M-CONSOLE-40).
            $checks[] = 'FAIL http-reachable ext-curl not loaded (install php-curl)';
            $allPassed = false;
        } else {
            $url = rtrim($serverUrl, '/') . '/api/v1/libraries';
            $ch = curl_init();
            curl_setopt($ch, CURLOPT_URL, $url);
            curl_setopt($ch, CURLOPT_RETURNTRANSFER, true);
            curl_setopt($ch, CURLOPT_TIMEOUT, 20);  // 20-second timeout (C0.3 timeout + overhead)
            curl_setopt($ch, CURLOPT_CONNECTTIMEOUT, 20);
            curl_setopt($ch, CURLOPT_SSL_VERIFYPEER, true);
            curl_setopt($ch, CURLOPT_HTTPHEADER, [
                'Accept: application/json',
            ]);
            $response = @curl_exec($ch);
            $httpCode = curl_getinfo($ch, CURLINFO_HTTP_CODE);
            $curlError = curl_error($ch);
            curl_close($ch);

            if ($response === false || $curlError !== '') {
                $checks[] = 'FAIL http-reachable curl error: ' . $curlError;
                $allPassed = false;
            } elseif ($httpCode === 0) {
                // HTTP code 0 means couldn't connect (e.g., DNS failure, connection refused)
                $checks[] = 'FAIL http-reachable connection failed (HTTP 0)';
                $allPassed = false;
            } elseif ($httpCode >= 200 && $httpCode < 300) {
                $checks[] = 'OK http-reachable';
            } elseif ($httpCode === 401) {
                // 401 means server is up and we're unauthenticated — which is fine
                $checks[] = 'OK http-reachable (401 unauthenticated)';
            } else {
                $checks[] = "FAIL http-reachable unexpected HTTP $httpCode";
                $allPassed = false;
            }

            // 4. decode-ok
            if ($allPassed && $response !== false) {
                try {
                    json_decode($response, false, 512, JSON_THROW_ON_ERROR);
                    $checks[] = 'OK decode-ok';
                } catch (\JsonException $e) {
                    $checks[] = 'FAIL decode-ok json error: ' . $e->getMessage();
                    $allPassed = false;
                }
            }
        }
    }

    // Print one line per check
    foreach ($checks as $line) {
        echo $line . "\n";
    }

    return $allPassed;
}

$cmd = $argv[1] ?? 'help';

/**
 * Normalise the `watch` command's arguments.
 *
 * Every option falls back to its environment variable so a headless watch
 * process can be configured without CLI flags. Secrets have a carrier ladder
 * (M-CONSOLE-35, CWE-214): env first, then `--hub-token-stdin` /
 * `--relay-token-stdin` (read from STDIN at resolution time), then the
 * DEPRECATED literal argv flags — which still parse (scripts stay alive)
 * but warn loudly the instant the literal is accepted (R-CONSOLE-11: the
 * warning was moved from `runWatch` to here, so a later malformed flag
 * can no longer kill the run before the exposure is named). Unknown
 * options, value-taking options without a value, and malformed values
 * (e.g. a non-numeric `--timeout`) are usage errors (exit 2).
 *
 * @param list<string> $argv Full argv (index 0 = script, 1 = "watch").
 *
 * @return array{hub: ?string, serverId: ?string, hubToken: ?string, relayToken: ?string,
 *               hubTokenFromArgv: bool, relayTokenFromArgv: bool,
 *               hubTokenStdin: bool, relayTokenStdin: bool, once: bool, timeout: int}
 */
function parseWatchArgs(array $argv): array
{
    $args = [
        'hub' => getenv('PHLIX_HUB_URL') ?: null,
        'serverId' => getenv('PHLIX_HUB_SERVER_ID') ?: null,
        'hubToken' => getenv('PHLIX_HUB_TOKEN') ?: null,
        'relayToken' => getenv('PHLIX_RELAY_TOKEN') ?: null,
        'hubTokenFromArgv' => false,
        'relayTokenFromArgv' => false,
        'hubTokenStdin' => false,
        'relayTokenStdin' => false,
        'once' => false,
        'timeout' => 30,
    ];

    /** Value-taking option names (must be followed by a non-option value). */
    $valueOptions = ['hub', 'server-id', 'hub-token', 'relay-token', 'timeout'];

    $rest = array_slice($argv, 2);
    for ($i = 0, $n = count($rest); $i < $n; $i++) {
        $arg = $rest[$i];
        if (!is_string($arg)) {
            continue;
        }
        if (str_starts_with($arg, '--')) {
            $name = substr($arg, 2);
            $value = null;
            if (str_contains($name, '=')) {
                [$name, $value] = explode('=', $name, 2);
            } elseif (in_array($name, $valueOptions, true)) {
                if (!isset($rest[$i + 1]) || !is_string($rest[$i + 1]) || str_starts_with($rest[$i + 1], '-')) {
                    throw new \InvalidArgumentException("Option --{$name} needs a value");
                }
                $value = $rest[++$i];
            }
            switch ($name) {
                case 'hub':
                    $args['hub'] = $value;
                    break;
                case 'server-id':
                    $args['serverId'] = $value;
                    break;
                case 'hub-token':
                    $args['hubToken'] = $value;
                    $args['hubTokenFromArgv'] = $value !== null && $value !== '';
                    // Warn at capture, not after parsing (R-CONSOLE-11):
                    // the secret is already in ps(1) from exec time, and a
                    // later flag's throw must not silence the warning.
                    warnArgvSecretCarrier(
                        $args['hubTokenFromArgv'],
                        'hub-token',
                        'PHLIX_HUB_TOKEN',
                        '--hub-token-stdin',
                    );
                    break;
                case 'hub-token-stdin':
                    if ($value !== null) {
                        throw new \InvalidArgumentException('Option --hub-token-stdin does not take a value');
                    }
                    $args['hubTokenStdin'] = true;
                    break;
                case 'relay-token':
                    $args['relayToken'] = $value;
                    $args['relayTokenFromArgv'] = $value !== null && $value !== '';
                    // Same warn-at-capture law as --hub-token (R-CONSOLE-11).
                    warnArgvSecretCarrier(
                        $args['relayTokenFromArgv'],
                        'relay-token',
                        'PHLIX_RELAY_TOKEN',
                        '--relay-token-stdin',
                    );
                    break;
                case 'relay-token-stdin':
                    if ($value !== null) {
                        throw new \InvalidArgumentException('Option --relay-token-stdin does not take a value');
                    }
                    $args['relayTokenStdin'] = true;
                    break;
                case 'once':
                    if ($value !== null) {
                        throw new \InvalidArgumentException('Option --once does not take a value');
                    }
                    $args['once'] = true;
                    break;
                case 'timeout':
                    if ($value === null || !ctype_digit($value) || (int) $value < 1) {
                        throw new \InvalidArgumentException('Option --timeout needs a positive integer value');
                    }
                    $args['timeout'] = (int) $value;
                    break;
                default:
                    throw new \InvalidArgumentException("Unknown option: --{$name}");
            }
        } else {
            throw new \InvalidArgumentException("Unexpected argument: {$arg}");
        }
    }

    if ($args['hubTokenStdin'] && $args['relayTokenStdin']) {
        throw new \InvalidArgumentException('Only one of --hub-token-stdin / --relay-token-stdin may read STDIN');
    }

    return $args;
}

/**
 * Name the CWE-214 exposure of a literal secret that arrived in argv —
 * emitted by `parseWatchArgs` the moment the literal is accepted, before
 * any connection or further validation, so even a run that dies on a
 * LATER malformed flag names the exposure (R-CONSOLE-11: this used to run
 * after parsing, where an earlier flag's throw silenced it — see the
 * `--hub-token SEC --timeout abc` pins).
 * The process still proceeds: silently breaking existing scripts is its
 * own honesty violation (the `phlix run` non-TTY refusal, 1b7dd9e, sets
 * the bar for how deprecations exit in this CLI — this one is a warning,
 * not a refusal, because a safe replacement carrier exists and is printed
 * in the very line). The secret value itself is never echoed.
 */
function warnArgvSecretCarrier(bool $fromArgv, string $flag, string $envName, string $stdinFlag): void
{
    if (!$fromArgv) {
        return;
    }
    fwrite(
        STDERR,
        sprintf(
            "warning: --%s puts a live secret in process argv — readable via ps(1), "
            . "/proc/<pid>/cmdline and shell history for the process lifetime (CWE-214)."
            . " Prefer env %s or %s.\n",
            $flag,
            $envName,
            $stdinFlag,
        ),
    );
}

/**
 * Read one secret off STDIN: the whole stream, trailing line breaks trimmed
 * (a bearer JWT never carries internal newlines). Returns null on an empty
 * or unreadable stream — the caller turns that into a usage error.
 */
function readSecretFromStdin(): ?string
{
    $raw = stream_get_contents(STDIN);
    if ($raw === false) {
        return null;
    }
    $token = rtrim($raw, "\r\n");

    return $token !== '' ? $token : null;
}

/**
 * Mint a fresh client relay token from the hub.
 *
 * `POST /api/v1/me/servers/{id}/relay-token` with the hub user's access token
 * returns `{token, expires_at, server_id}`. Relay tokens are short-lived (1h
 * default), so the watch loop re-mints on every (re)connect via its token
 * provider. Returns null on any failure — the socket then stays closed.
 */
function mintRelayToken(string $hubUrl, string $serverId, string $hubToken): ?string
{
    // ext-curl is not a declared dependency; without it the mint fails closed
    // (null → the watch ladder retries with the next token read).
    if (!function_exists('curl_init')) {
        return null;
    }

    $ch = curl_init();
    $mintUrl = rtrim($hubUrl, '/') . '/api/v1/me/servers/'
        . rawurlencode($serverId) . '/relay-token';
    curl_setopt($ch, CURLOPT_URL, $mintUrl);
    curl_setopt($ch, CURLOPT_POST, true);
    curl_setopt($ch, CURLOPT_RETURNTRANSFER, true);
    curl_setopt($ch, CURLOPT_TIMEOUT, 15);
    curl_setopt($ch, CURLOPT_CONNECTTIMEOUT, 15);
    curl_setopt($ch, CURLOPT_HTTPHEADER, [
        'Authorization: Bearer ' . $hubToken,
        'Accept: application/json',
    ]);
    $body = @curl_exec($ch);
    $httpCode = curl_getinfo($ch, CURLINFO_HTTP_CODE);
    curl_close($ch);

    if ($body === false || $httpCode < 200 || $httpCode >= 300) {
        return null;
    }

    $data = json_decode($body, true);
    if (!is_array($data)) {
        return null;
    }
    $token = $data['token'] ?? null;

    return is_string($token) && $token !== '' ? $token : null;
}

/**
 * Run the hub-relay `watch` command (S298 — console half).
 *
 * Long-running by default: connects to the hub's SyncPlay relay (:8804,
 * `/syncplay/{server_id}`) with an `Authorization: Bearer` relay token and
 * dispatches every delivered `pending_command` / `play_media` frame to the
 * load-a-new-title path. The token provider re-reads on every (re)connect:
 * a ready-made relay token is used as-is, otherwise one is minted from the
 * hub with the hub user token. Secret carriers follow the M-CONSOLE-35
 * ladder: env, then `--hub-token-stdin` / `--relay-token-stdin`, then the
 * DEPRECATED literal argv flags (accepted, warned). `--once` connects,
 * waits for ONE frame (or
 * `--timeout` seconds) and exits.
 *
 * Exit codes: 0 = a play_media frame was received and dispatched (with
 * `--once`, also on a clean run); 2 = usage error; 1 = watch failed (no
 * frame within the `--once` timeout, or the reconnect ladder gave up).
 */
function runWatch(array $argv): int
{
    try {
        $args = parseWatchArgs($argv);
    } catch (\InvalidArgumentException $e) {
        fwrite(STDERR, "Error: " . $e->getMessage() . "\n");
        fwrite(STDERR, "usage: phlix watch [--hub URL] [--server-id ID] [--hub-token-stdin | --relay-token-stdin]\n");
        fwrite(STDERR, "                  [--once] [--timeout SECS]  (or env PHLIX_HUB_URL / PHLIX_HUB_SERVER_ID / PHLIX_HUB_TOKEN / PHLIX_RELAY_TOKEN)\n");
        return 2;
    }

    // The CWE-214 warning for literal argv secrets fires at parse-capture
    // inside parseWatchArgs (R-CONSOLE-11), so a run that dies on a later
    // usage error still named the exposure. (M-CONSOLE-35)
    $hub = $args['hub'];
    $serverId = $args['serverId'];
    if ($hub === null || $hub === '' || $serverId === null || $serverId === '') {
        fwrite(STDERR, "Error: watch needs --hub and --server-id (env PHLIX_HUB_URL / PHLIX_HUB_SERVER_ID)\n");
        return 2;
    }
    $relayToken = $args['relayToken'];
    $hubToken = $args['hubToken'];
    if ($args['hubTokenStdin']) {
        $read = readSecretFromStdin();
        if ($read === null) {
            fwrite(STDERR, "Error: --hub-token-stdin needs the token on STDIN\n");
            return 2;
        }
        $hubToken = $read;
    }
    if ($args['relayTokenStdin']) {
        $read = readSecretFromStdin();
        if ($read === null) {
            fwrite(STDERR, "Error: --relay-token-stdin needs the token on STDIN\n");
            return 2;
        }
        $relayToken = $read;
    }
    if (($relayToken === null || $relayToken === '') && ($hubToken === null || $hubToken === '')) {
        fwrite(STDERR, "Error: watch needs --relay-token or --hub-token"
            . " (env PHLIX_RELAY_TOKEN / PHLIX_HUB_TOKEN; or --relay-token-stdin / --hub-token-stdin)\n");
        return 2;
    }

    $received = false;
    $once = $args['once'];

    $tokenProvider = static function () use ($relayToken, $hub, $serverId, $hubToken): ?string {
        if ($relayToken !== null && $relayToken !== '') {
            return $relayToken;
        }
        if ($hubToken === null || $hubToken === '') {
            return null;
        }

        return mintRelayToken($hub, $serverId, $hubToken);
    };

    $consumer = new HubRelayConsumer(
        hubBaseUrl: $hub,
        serverId: $serverId,
        tokenProvider: $tokenProvider,
        onPendingCommand: static function (PendingPlayMediaCommand $command) use (&$received, $once): void {
            // The load-a-new-title dispatch point: a delivered play_media
            // frame reaches here with the carried media_id. The console's
            // playback surface is the interactive TUI (`phlix run`); the
            // watch command prints the play request it would hand the player.
            fwrite(STDOUT, sprintf(
                "Now playing: %s (media_id=%s server_id=%s source=%s)\n",
                $command->title,
                $command->mediaId,
                $command->serverId,
                $command->source,
            ));
            $received = true;
            if ($once) {
                Worker::$globalEvent->stop();
            }
        },
        onStatusChange: static function (string $status) use (&$received): void {
            fwrite(STDERR, "hub relay: {$status}\n");
            if ($status === 'exhausted') {
                // The reconnect ladder gave up. Stop the loop: the exit code
                // ($received ? 0 : 1) already says "delivery proven, ladder
                // dead, shutting down" — a silent idle would be worse than
                // either outcome.
                Worker::$globalEvent->stop();
            }
        },
    );

    // The Workerman client socket needs a global event loop; a watch process
    // is a client only, so spin up the plain Select loop (no Worker::runAll).
    // Mirror Worker's own convention and install an error handler so an
    // exception inside a Workerman-internal callback logs and stops cleanly
    // instead of escaping run() with a raw trace.
    Worker::$globalEvent = new Select();
    Worker::$globalEvent->setErrorHandler(static function (\Throwable $e): void {
        fwrite(STDERR, 'hub relay: event loop error: ' . $e->getMessage() . "\n");
        Worker::$globalEvent->stop();
    });
    Timer::init(Worker::$globalEvent);

    $consumer->open();

    if ($once) {
        $timeout = $args['timeout'];
        Timer::add($timeout, static function () use (&$received, $timeout): void {
            if (!$received) {
                fwrite(STDERR, "hub relay: no pending_command received within {$timeout}s\n");
                Worker::$globalEvent->stop();
            }
        }, [], false);
    }

    Worker::$globalEvent->run();

    return $received ? 0 : 1;
}

/**
 * Pull a render mode out of argv: --mode=sixel, --mode sixel, or a bare
 * `sixel` trailing on run/poster/frame (review M-CONSOLE-61).
 *
 * The flag form is validated against $KNOWN_MODES right here and exits 2 —
 * the usage-error code this entrypoint's own contract reserves (:9-10,
 * honoured by parseWatchArgs). Letting a typo reach MosaicFactory::forMode()
 * made it a thrown InvalidArgumentException caught by the outer handler:
 * exit 1, the generic-exception code, for the textbook usage error.
 *
 * The bare form is restricted to the commands that actually consume $mode
 * and to the final argv position: a mode word in the middle of `phlix frame`
 * used to be silently absorbed as the decode mode while still being skipped
 * as a positional number, mutating the behaviour of what looked like a
 * plain frame extraction.
 */
$KNOWN_MODES = ['auto', 'halfblock', 'half', 'ansi', 'quarterblock', 'quarter',
    'ascii', 'ansi256', 'truecolor', 'sixel', 'kitty', 'iterm2'];
$mode = null;
$modeFromFlag = false;
foreach ($argv as $i => $arg) {
    if (!is_string($arg)) {
        continue;
    }
    if (str_starts_with($arg, '--mode=')) {
        $mode = substr($arg, 7);              // --mode=sixel
        $modeFromFlag = true;
    } elseif ($arg === '--mode' && isset($argv[$i + 1]) && is_string($argv[$i + 1])) {
        $mode = $argv[$i + 1];                // --mode sixel
        $modeFromFlag = true;
    }
}
if ($mode === null && count($argv) >= 3 && in_array($cmd, ['run', 'poster', 'frame'], true)) {
    $last = $argv[count($argv) - 1];
    if (is_string($last) && in_array($last, $KNOWN_MODES, true)) {
        $mode = $last;                        // trailing bare mode, e.g. `phlix run sixel`
    }
}
if ($modeFromFlag && !in_array(strtolower(trim((string) $mode)), $KNOWN_MODES, true)) {
    fwrite(STDERR, "Error: unknown render mode: {$mode}\n");
    fwrite(STDERR, 'usage: --mode one of ' . implode(' | ', $KNOWN_MODES) . "  (see: phlix help)\n");
    exit(2);
}
$intArg = static fn(int $i, int $default): int =>
    isset($argv[$i]) && ctype_digit((string) $argv[$i]) ? (int) $argv[$i] : $default;

try {
    switch ($cmd) {
        case 'doctor':
            $config = Config::load();
            $serverUrl = getenv('PHLIX_SERVER_URL') ?: $config->activeServer()?->url;
            $tokenPath = TokenStore::default()->path();
            $cacheDir = Config::dir() . '/posters';
            $cacheEntries = (int) getenv('PHLIX_POSTER_CACHE_ENTRIES');
            if ($cacheEntries < 1) {
                $cacheEntries = 16384;
            }
            $posterCache = new DiskCache($cacheDir, $cacheEntries);

            echo "PHP version: " . PHP_VERSION . "\n";
            echo "Config path: " . Config::path() . "\n";
            if ($config->loadError !== null) {
                // A broken config file is data-safe but never silent [review console__qa m-3].
                echo "Config WARN: " . $config->loadError . "\n";
            }
            echo "Token path: " . $tokenPath . "\n";
            echo "Server URL: " . ($serverUrl ?? '(none)') . "\n";
            echo "\n";
            echo (new Capabilities())->report(), "\n";
            echo "\n";
            echo "Poster cache directory: {$cacheDir}\n";
            echo "Poster cache entry limit: {$cacheEntries}\n";
            echo "Poster cache current entries: " . $posterCache->count() . "\n";

            if ($serverUrl !== null && $serverUrl !== '') {
                echo "\nServer reachability:\n";
                if (!function_exists('curl_init')) {
                    // ext-curl is not a declared dependency: report the missing
                    // probe honestly instead of fataling on undefined functions
                    // (same law as mintRelayToken; review M-CONSOLE-40).
                    echo "  FAIL: PHP extension curl is not loaded — install php-curl to probe reachability\n";
                } else {
                    $ch = curl_init();
                    curl_setopt($ch, CURLOPT_URL, rtrim($serverUrl, '/') . '/api/v1/libraries');
                    curl_setopt($ch, CURLOPT_RETURNTRANSFER, true);
                    curl_setopt($ch, CURLOPT_TIMEOUT, 10);
                    curl_setopt($ch, CURLOPT_CONNECTTIMEOUT, 10);
                    curl_setopt($ch, CURLOPT_SSL_VERIFYPEER, true);
                    $response = @curl_exec($ch);
                    $httpCode = curl_getinfo($ch, CURLINFO_HTTP_CODE);
                    $curlError = curl_error($ch);
                    curl_close($ch);

                    if ($response === false || $curlError !== '') {
                        echo "  FAIL: " . ($curlError ?: 'Connection failed') . "\n";
                    } elseif ($httpCode === 0) {
                        echo "  FAIL: Connection failed (HTTP 0)\n";
                    } elseif ($httpCode >= 200 && $httpCode < 300) {
                        echo "  OK: Server is reachable\n";
                    } elseif ($httpCode === 401) {
                        echo "  OK: Server is reachable (401 unauthenticated)\n";
                    } else {
                        echo "  WARN: Unexpected HTTP $httpCode\n";
                    }
                }
            }
            break;

        case 'poster':
            $path = $argv[2] ?? null;
            if ($path === null) {
                fwrite(STDERR, "usage: phlix poster <image> [width] [height] [--mode=auto|halfblock|quarterblock|ascii|ansi256|truecolor|sixel|kitty|iterm2]\n");
                exit(2);
            }
            echo (new PosterSpike())->render($path, $intArg(3, 40), isset($argv[4]) && ctype_digit((string) $argv[4]) ? (int) $argv[4] : null, $mode), "\n";
            break;

        case 'frame':
            $src = $argv[2] ?? null;
            if ($src === null) {
                fwrite(STDERR, "usage: phlix frame <video|gif> [count] [cols] [rows] [--mode=auto|halfblock|sixel|kitty|ascii]\n");
                exit(2);
            }
            $spike = new VideoSpike();
            echo $spike->probeReport($src), "\n";
            foreach ($spike->frames($src, $intArg(3, 1), $intArg(4, 60), $intArg(5, 20), $mode) as $i => $ansi) {
                echo "--- frame {$i} ---\n", $ansi, "\n";
            }
            break;

        case 'run':
            if (in_array('--selftest', $argv, true)) {
                $result = runSelftest($mode);
                exit($result ? 0 : 1);
            }
            // The full-window app reads keystrokes from STDIN in raw mode.
            // A piped, file-redirected, or otherwise non-terminal stdin is
            // never a keyboard: the input reader spins against a dead stream
            // while the renderer paints escape sequences into the pipe, and
            // the process only dies when something external kills it (the
            // non-TTY freeze). Refuse at the boundary instead — exit 2 is the
            // usage-error code this entrypoint already reserves for the same
            // class of problem (unknown command, bad watch flags). The help
            // text has always promised "needs a TTY"; now the code enforces
            // it. `run --selftest` above stays headless-safe by design.
            if (!stream_isatty(STDIN)) {
                fwrite(STDERR, "Error: phlix run needs a TTY (stdin is not a terminal)\n");
                fwrite(STDERR, "headless check? use: phlix run --selftest\n");
                exit(2);
            }
            $container = buildContainer($mode);
            // Enable bracketed paste (terminal mode 2004): the terminal then
            // wraps a paste in ESC[200~…ESC[201~ and sugar-core surfaces it as
            // ONE PasteMsg, which App::dispatch() replays as the equivalent
            // key sequence [review console__tuispec M44]. Without this half
            // there is no envelope to consume: raw pasted newlines would keep
            // auto-submitting half-filled forms.
            (new Program(App::boot(
                $container['config'],
                $container['auth'],
                $container['api'],
                $container['libraries'],
                $container['media'],
                $container['posters'],
            ), new ProgramOptions(bracketedPaste: true)))->run();
            break;

        case 'watch':
            exit(runWatch($argv));

        case '--version':
        case '-V':
        case 'version':
            echo "phlix " . PHLIX_VERSION . "\n";
            exit(0);

        case 'help':
        case '--help':
        case '-h':
            fwrite(STDOUT, HELP_TEXT);
            exit(0);

        default:
            fwrite(STDERR, "Unknown command: {$cmd}\n");
            fwrite(STDERR, HELP_TEXT);
            exit(2);
    }
} catch (\Throwable $e) {
    fwrite(STDERR, 'Error: ' . $e->getMessage() . "\n");
    exit(1);
}
