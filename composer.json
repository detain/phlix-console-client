{
    "name": "phlix/console-client",
    "description": "Full-window terminal (TUI) client for Phlix — browse libraries and posters and play media in the terminal, rendered as sixel / kitty / iTerm2 / half-block ANSI via the SugarCraft stack.",
    "type": "project",
    "license": "MIT",
    "keywords": ["phlix", "tui", "terminal", "media", "sugarcraft", "sixel", "kitty", "client"],
    "authors": [
        { "name": "Joe Huss", "email": "detain@interserver.net", "role": "Maintainer" }
    ],
    "bin": ["bin/phlix"],
    "require": {
        "php": ">=8.3",
        "ext-gd": "*",
        "react/event-loop": "^1.5",
        "react/http": "^1.11",
        "react/promise": "^3.3",
        "react/promise-timer": "^1.11",
        "sugarcraft/sugar-core": "dev-master",
        "sugarcraft/sugar-focus": "dev-master",
        "sugarcraft/sugar-forms": "dev-master",
        "sugarcraft/sugar-fuzzy": "dev-master",
        "sugarcraft/sugar-quickpick": "dev-master",
        "sugarcraft/sugar-image": "dev-master",
        "sugarcraft/sugar-colorprofile": "dev-master",
        "sugarcraft/sugar-markdown": "dev-master",
        "sugarcraft/sugar-style": "dev-master",
        "sugarcraft/sugar-panels": "dev-master",
        "sugarcraft/sugar-crumbs": "dev-master",
        "sugarcraft/sugar-gallery": "dev-master",
        "sugarcraft/sugar-reel": "dev-master",
        "sugarcraft/sugar-table": "dev-master",
        "sugarcraft/sugar-toast": "dev-master",
        "sugarcraft/sugar-veil": "dev-master",
        "workerman/workerman": "^5.0"
    },
    "require-dev": {
        "humbug/box": "^4.7",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.0",
        "squizlabs/php_codesniffer": "^4.0",
        "sugarcraft/sugar-testing": "dev-master"
    },
    "autoload": {
        "psr-4": {
            "Phlix\\Console\\": "src/",
            "SugarCraft\\Reel\\Tests\\": "vendor/sugarcraft/sugar-reel/tests/"
        }
    },
    "autoload-dev": {
        "psr-4": { "Phlix\\Console\\Tests\\": "tests/" }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "phpstan": "phpstan analyse",
    "cs": [
      "phpcs --standard=phpcs.xml --colors src/",
      "phpcs --standard=phpcs-tests.xml --colors tests/"
    ],
    "cs:fix": [
      "phpcbf --standard=phpcs.xml src/",
      "phpcbf --standard=phpcs-tests.xml tests/"
    ],
        "i18n:hardcoded": "php scripts/check-i18n-hardcoded.php",
        "i18n:catalogs": "php scripts/check-i18n-catalogs.php",
        "i18n:check": [
            "@i18n:hardcoded",
            "@i18n:catalogs"
        ]
    }
}
